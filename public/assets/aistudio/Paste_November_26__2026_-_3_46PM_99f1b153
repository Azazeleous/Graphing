        geoPulseMesh.setColorAt(i, new THREE.Color().setHSL(i >= GEO_EDGE_COUNT ? 0.82 : 0.50, 1.0, 0.65));
      }
      geoPulseMesh.instanceColor.needsUpdate = true;
      masterGroup.add(geoPulseMesh);

      const geoSpaceMarkersMesh = new THREE.InstancedMesh(
        new THREE.OctahedronGeometry(0.055, 0),
        new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.85, blending: THREE.AdditiveBlending }),
        GEO_VERT_COUNT * 2
      );
      geoSpaceMarkersMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
      for (let i = 0; i < GEO_VERT_COUNT * 2; i++) {
        geoSpaceMarkersMesh.setColorAt(i, new THREE.Color().setHSL(i >= GEO_VERT_COUNT ? 0.78 : 0.48, 0.95, 0.62));
      }
      geoSpaceMarkersMesh.instanceColor.needsUpdate = true;
      masterGroup.add(geoSpaceMarkersMesh);

      // Menger-Sierpinski 1:1:1 Lattice
      let fractalMesh = null, duplicateShellMesh = null, latticeLines = null;
      let fractalNodes = [], outerShellNodes = [], latticeSegments = [];
      const dummy = new THREE.Object3D();
      const tempColor = new THREE.Color();

      function generateSierpinski111Grid(level) {
        const points = [];
        const gridDim = Math.pow(3, level);
        const halfSpan = (gridDim - 1) / 2;
        const cellStep = 2.45 / gridDim;
        const pointMap = new Map();

        function recurse(gx, gy, gz, span, depth) {
          if (depth === 0) {
            const idx = points.length;
            const isExteriorShell = gx === 0 || gx === gridDim - 1 || gy === 0 || gy === gridDim - 1 || gz === 0 || gz === gridDim - 1;
            const encodedAddress = `S${String(gx).padStart(2, '0')}${String(gy).padStart(2, '0')}${String(gz).padStart(2, '0')}`;
            points.push({
              idx, gx, gy, gz, encodedAddress,
              x: (gx - halfSpan) * cellStep,
              y: (gy - halfSpan) * cellStep,
              z: (gz - halfSpan) * cellStep,
              size: cellStep,
              isExteriorShell
            });
            pointMap.set(`${gx},${gy},${gz}`, idx);
            return;
          }
          const sub = span / 3;
          for (let dx = 0; dx < 3; dx++) {
            for (let dy = 0; dy < 3; dy++) {
              for (let dz = 0; dz < 3; dz++) {
                if ((dx === 1 ? 1 : 0) + (dy === 1 ? 1 : 0) + (dz === 1 ? 1 : 0) <= 1) {
                  recurse(gx + dx * sub, gy + dy * sub, gz + dz * sub, sub, depth - 1);
                }
              }
            }
          }
        }
        recurse(0, 0, 0, gridDim, level);

        const segments = [];
        const dirs = [{ dx: 1, dy: 0, dz: 0, axis: 0 }, { dx: 0, dy: 1, dz: 0, axis: 1 }, { dx: 0, dy: 0, dz: 1, axis: 2 }];
        for (let i = 0; i < points.length; i++) {
          const p = points[i];
          for (let d = 0; d < dirs.length; d++) {
            const nIdx = pointMap.get(`${p.gx + dirs[d].dx},${p.gy + dirs[d].dy},${p.gz + dirs[d].dz}`);
            if (nIdx !== undefined) {
              segments.push({ a: i, b: nIdx, axis: dirs[d].axis, phase: (p.gx + p.gy + p.gz) * 0.25 + dirs[d].axis * (Math.PI / 3) });
            }
          }
        }
        return { points, segments };
      }

      function buildFractalOrb(level) {
        if (fractalMesh) { masterGroup.remove(fractalMesh); fractalMesh.geometry.dispose(); fractalMesh.material.dispose(); }
        if (duplicateShellMesh) { masterGroup.remove(duplicateShellMesh); duplicateShellMesh.geometry.dispose(); duplicateShellMesh.material.dispose(); }
        if (latticeLines) { masterGroup.remove(latticeLines); latticeLines.geometry.dispose(); latticeLines.material.dispose(); }

        const { points, segments } = generateSierpinski111Grid(level);
        latticeSegments = segments;
        outerShellNodes = [];

        fractalNodes = points.map(pt => {
          const cubeVec = new THREE.Vector3(pt.x, pt.y, pt.z);
          const len = cubeVec.length();
          const sphereVec = len > 0.0001 ? cubeVec.clone().normalize().multiplyScalar(2.05) : new THREE.Vector3();
          const node = {
            gx: pt.gx, gy: pt.gy, gz: pt.gz, encodedAddress: pt.encodedAddress,
            cubeVec, sphereVec, currentPos: new THREE.Vector3(),
            baseSize: pt.size * 0.72, normDist: Math.min(len / 2.15, 1.0)
          };
          if (pt.isExteriorShell) outerShellNodes.push(node);
          return node;
        });

        fractalMesh = new THREE.InstancedMesh(
          new THREE.BoxGeometry(0.68, 0.68, 0.68),
          new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.22, metalness: 0.8, emissive: 0x0a192f, emissiveIntensity: 0.55 }),
          fractalNodes.length
        );
        fractalMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
        for (let i = 0; i < fractalNodes.length; i++) {
          tempColor.setHSL(0.51 + fractalNodes[i].normDist * 0.35, 0.92, 0.56);
          fractalMesh.setColorAt(i, tempColor);
        }
        fractalMesh.instanceColor.needsUpdate = true;
        masterGroup.add(fractalMesh);

        duplicateShellMesh = new THREE.InstancedMesh(
          new THREE.OctahedronGeometry(0.32, 0),
          new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.65, blending: THREE.AdditiveBlending }),
          outerShellNodes.length
        );
        duplicateShellMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
        for (let i = 0; i < outerShellNodes.length; i++) {
          tempColor.setHSL(0.78 - outerShellNodes[i].normDist * 0.25, 0.95, 0.62);
          duplicateShellMesh.setColorAt(i, tempColor);
        }
        duplicateShellMesh.instanceColor.needsUpdate = true;
        masterGroup.add(duplicateShellMesh);

        const lineGeo = new THREE.BufferGeometry();
        lineGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(latticeSegments.length * 6), 3));
        lineGeo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(latticeSegments.length * 6), 3));
        latticeLines = new THREE.LineSegments(lineGeo, new THREE.LineBasicMaterial({
          vertexColors: true, transparent: true, opacity: level === 3 ? 0.28 : 0.55, blending: THREE.AdditiveBlending
        }));
        masterGroup.add(latticeLines);
      }

      // -4D Tesseract Point Registry & Dual-Layer Edges
      const tesseractPointRegistry = [];
      for (let i = 0; i < 16; i++) {
        const b0 = (i & 1) ? 1 : 0, b1 = (i & 2) ? 1 : 0, b2 = (i & 4) ? 1 : 0, b3 = (i & 8) ? 1 : 0;
        tesseractPointRegistry.push({
          id: i, code: `V${String(i).padStart(2, '0')}`, binary: `${b3}${b2}${b1}${b0}`,
          v4: [b0 ? 1 : -1, b1 ? 1 : -1, b2 ? 1 : -1, b3 ? 1 : -1],
          prevL1: new THREE.Vector3(), prevL2: new THREE.Vector3(), velL1: 0, velL2: 0
        });
      }

      const tesseractEdges = [];
      for (let i = 0; i < 16; i++) {
        for (let j = i + 1; j < 16; j++) {
          const diff = i ^ j;
          if (diff === 1 || diff === 2 || diff === 4 || diff === 8) tesseractEdges.push({ a: i, b: j });
        }
      }

      function createEdgeSegments(opacity) {
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(tesseractEdges.length * 6), 3));
        g.setAttribute('color', new THREE.BufferAttribute(new Float32Array(tesseractEdges.length * 6), 3));
        return new THREE.LineSegments(g, new THREE.LineBasicMaterial({
          vertexColors: true, transparent: true, opacity, blending: THREE.AdditiveBlending
        }));
      }

      const tesseractLines = createEdgeSegments(0.92);
      const dupTesseractLines = createEdgeSegments(0.78);
      masterGroup.add(tesseractLines, dupTesseractLines);

      const anchorBridgeGeo = new THREE.BufferGeometry();
      anchorBridgeGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(16 * 6), 3));
      anchorBridgeGeo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(16 * 6), 3));
      const anchorBridgeLines = new THREE.LineSegments(anchorBridgeGeo, new THREE.LineBasicMaterial({
