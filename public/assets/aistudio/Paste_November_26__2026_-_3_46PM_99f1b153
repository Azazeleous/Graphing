<body>

  <!-- 250x Cryptics Fieyld Optics Radial Background Canvas (Continuous) -->
  <canvas id="fieldCanvas"></canvas>

  <!-- 3D/4D Geodesic Sierpinski-Tesseract Spherical Orb Canvas -->
  <div id="orbContainer"></div>

  <div id="launch-flash"></div>
  <div id="point-reticle">V00 [-4D:0000] • G00</div>

  <!-- Top-Left Unified Masthead -->
  <div class="hud-header">
    <div class="symbol-badge">◆ NEXUS OMNI // GEODESIC -4D × 250x FIEYLD OPTICS</div>
    <div class="hud-title">Sierpinski-Tesseract Spherical Orb · SYNAPSE Conductor</div>
