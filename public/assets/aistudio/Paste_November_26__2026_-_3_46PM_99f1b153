      trailGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(TOTAL_VERTICES * (TRAIL_LENGTH - 1) * 6), 3));
      trailGeo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(TOTAL_VERTICES * (TRAIL_LENGTH - 1) * 6), 3));
      const tesseractTrails = new THREE.LineSegments(trailGeo, new THREE.LineBasicMaterial({
        vertexColors: true, transparent: true, opacity: 0.62, blending: THREE.AdditiveBlending
      }));
      masterGroup.add(tesseractTrails);

      const vertexHistory = Array.from({ length: TOTAL_VERTICES }, () => []);
      const tesseractNodesMesh = new THREE.InstancedMesh(
        new THREE.OctahedronGeometry(0.08, 0),
        new THREE.MeshBasicMaterial({ color: 0xffffff, blending: THREE.AdditiveBlending }),
        TOTAL_VERTICES
