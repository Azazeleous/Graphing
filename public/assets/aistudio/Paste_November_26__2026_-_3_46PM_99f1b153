      async function runAllChecks() {
        termPrint('Running local deterministic verification checks…', 'mut');
        const pRes = computePrimes('100', 6);
        const rRes = computeResources();
        const rec1 = await ledger.append('check_primes', { start: '100', count: 6 }, pRes);
        const rec2 = await ledger.append('check_resources', { sectors: 12, ticks: 120 }, rRes);
        const ver = await ledger.verify();
        termPrint(`PASS Primes(100,6): [${pRes.primes.join(', ')}] (Receipt #${rec1.sequence})`, 'sys');
        termPrint(`PASS Resource Conservation Residual: ${rRes.global_residual} (Receipt #${rec2.sequence})`, 'sys');
        termPrint(`PASS Ledger Chain Verified: ${ver.count} records · Head ${ver.head.slice(0, 16)}…`, 'sys');
      }

      document.getElementById('btn-run-checks').addEventListener('click', runAllChecks);
      document.getElementById('btn-verify-ledger').addEventListener('click', async () => {
        try {
          const ver = await ledger.verify();
          termPrint(`CHAIN VERIFIED: ${ver.count} append-only records · Head ${ver.head ? ver.head.slice(0, 20) + '…' : 'GENESIS'}`, 'sys');
        } catch (err) {
          termPrint('CHAIN ERROR: ' + err.message, 'err');
        }
      });

      document.getElementById('synapse-form').addEventListener('submit', async e => {
        e.preventDefault();
        const raw = document.getElementById('synapse-input').value.trim();
        document.getElementById('synapse-input').value = '';
        if (!raw) return;
        termPrint('Æ› ' + raw, 'usr');
        const [cmd, a1, a2] = raw.split(/\s+/);
        try {
          if (cmd === 'help') {
            termPrint('Commands: help · checks · primes <start> <count> · resources · receipts · -4d · relaunch', 'mut');
          } else if (cmd === 'checks') {
            await runAllChecks();
          } else if (cmd === 'primes') {
            const out = computePrimes(a1 || '100', a2 || 6);
            const rec = await ledger.append('primes', { start: a1 || '100', count: Number(a2 || 6) }, out);
            termPrint(`Primes: ${out.primes.join(', ')} | Product: ${out.product} (Receipt #${rec.sequence})`, 'sys');
          } else if (cmd === 'resources') {
            const out = computeResources();
            const rec = await ledger.append('resources', { sectors: 12, ticks: 120 }, out);
            termPrint(`Pool: ${out.pool} | Retained: ${out.retained} | Residual: ${out.global_residual} (Receipt #${rec.sequence})`, 'sys');
          } else if (cmd === 'receipts') {
            const ver = await ledger.verify();
            termPrint(`Ledger Records: ${ver.count} | Head Hash: ${ver.head || 'EMPTY'}`, 'sys');
          } else if (cmd === '-4d') {
            btnPolarity.click();
            termPrint(`Toggled 4D Polarity -> ${params.negative4D ? '-4D INVERSE (-W)' : '+4D POSITIVE (+W)'}`, 'sys');
          } else if (cmd === 'relaunch') {
            triggerLaunch();
            termPrint('Re-launched Geodesic Sierpinski-Tesseract Orb.', 'sys');
          } else {
            await ledger.append('unknown_command_preserved', { command: raw }, { note: 'Failure preserved per Layer 6 rule' }, 'faulted', 'Unrecognized command');
            termPrint(`Unknown command "${cmd}" (preserved as failure record in Layer 6 ledger). Type "help".`, 'err');
          }
        } catch (err) {
          await ledger.append('command_error', { command: raw }, {}, 'faulted', err.message);
          termPrint('Error: ' + err.message, 'err');
        }
      });

      window.addEventListener('resize', () => {
        initRadialField();
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      // =========================================================================
      // PART 5: UNIFIED CONTINUOUS ANIMATION LOOP (250x FIELD + 3D/4D ORB)
      // =========================================================================
      function updateTesseractEdgeBuffer(geo, vertices3D, maxCap, elapsed, hueBase) {
        const posAttr = geo.attributes.position.array;
        const colAttr = geo.attributes.color.array;
        for (let i = 0; i < tesseractEdges.length; i++) {
          const edge = tesseractEdges[i];
          const pA = vertices3D[edge.a], pB = vertices3D[edge.b];
          const stretchRatio = Math.min(1, pA.distanceTo(pB) / (maxCap * 1.4));
          const offset = i * 6;
          posAttr[offset] = pA.x; posAttr[offset + 1] = pA.y; posAttr[offset + 2] = pA.z;
          posAttr[offset + 3] = pB.x; posAttr[offset + 4] = pB.y; posAttr[offset + 5] = pB.z;
          const wave = 0.5 + 0.5 * Math.sin(elapsed * 3.5 + i * 0.4);
          tempColor.setHSL((hueBase + stretchRatio * 0.32) % 1.0, 1.0, 0.50 + wave * 0.25);
          colAttr[offset] = tempColor.r; colAttr[offset + 1] = tempColor.g; colAttr[offset + 2] = tempColor.b;
          colAttr[offset + 3] = tempColor.r; colAttr[offset + 4] = tempColor.g; colAttr[offset + 5] = tempColor.b;
        }
        geo.attributes.position.needsUpdate = true;
        geo.attributes.color.needsUpdate = true;
      }

      const lerpPulseVec = new THREE.Vector3();
      function updateGeodesicLattice(elapsed, layer1Cap, layer2Cap, ovalScaleVec1, ovalScaleVec2, launchEase) {
        const coupling = params.geodesicCoupling;
        const r1Base = layer1Cap * 0.87, r2Base = layer2Cap * 0.87;

        for (let i = 0; i < GEO_VERT_COUNT; i++) {
          const gv = geodesicTopology.vertices[i];
          const uv = gv.unitVec;
          gv.posL1.set(
            uv.x * r1Base * (1 + (ovalScaleVec1.x - 1) * 0.65 * coupling),
            uv.y * r1Base * (1 + (ovalScaleVec1.y - 1) * 0.65 * coupling),
            uv.z * r1Base * (1 + (ovalScaleVec1.z - 1) * 0.65 * coupling)
          );
          if (gv.posL1.length() > layer1Cap) gv.posL1.multiplyScalar(layer1Cap / gv.posL1.length());

          gv.posL2.set(
            uv.x * r2Base * (1 + (ovalScaleVec2.x - 1) * 0.65 * coupling),
            uv.y * r2Base * (1 + (ovalScaleVec2.y - 1) * 0.65 * coupling),
            uv.z * r2Base * (1 + (ovalScaleVec2.z - 1) * 0.65 * coupling)
          );
          if (gv.posL2.length() > layer2Cap) gv.posL2.multiplyScalar(layer2Cap / gv.posL2.length());

          dummy.position.copy(gv.posL1);
          dummy.rotation.set(elapsed * 0.6, elapsed * 0.6, 0);
          dummy.scale.setScalar((0.65 + 0.45 * coupling) * launchEase);
          dummy.updateMatrix();
          geoSpaceMarkersMesh.setMatrixAt(i, dummy.matrix);

          dummy.position.copy(gv.posL2);
          dummy.rotation.set(-elapsed * 0.6, -elapsed * 0.6, 0);
          dummy.scale.setScalar((0.75 + 0.50 * coupling) * launchEase);
          dummy.updateMatrix();
          geoSpaceMarkersMesh.setMatrixAt(GEO_VERT_COUNT + i, dummy.matrix);
        }
        geoSpaceMarkersMesh.instanceMatrix.needsUpdate = true;

        const pos1 = geodesicLinesL1.geometry.attributes.position.array;
        const col1 = geodesicLinesL1.geometry.attributes.color.array;
        const pos2 = geodesicLinesL2.geometry.attributes.position.array;
        const col2 = geodesicLinesL2.geometry.attributes.color.array;
        const dirSign = params.negative4D ? -1 : 1;

        for (let e = 0; e < GEO_EDGE_COUNT; e++) {
          const edge = geodesicTopology.edges[e];
          const vA = geodesicTopology.vertices[edge.a], vB = geodesicTopology.vertices[edge.b];
          const offset = e * 6;

          pos1[offset] = vA.posL1.x; pos1[offset + 1] = vA.posL1.y; pos1[offset + 2] = vA.posL1.z;
          pos1[offset + 3] = vB.posL1.x; pos1[offset + 4] = vB.posL1.y; pos1[offset + 5] = vB.posL1.z;
          const wave1 = 0.5 + 0.5 * Math.sin(elapsed * 3.8 * dirSign - e * 0.18);
          tempColor.setHSL(0.49 + wave1 * 0.10, 0.95, (0.35 + wave1 * 0.35) * coupling);
          col1[offset] = tempColor.r; col1[offset + 1] = tempColor.g; col1[offset + 2] = tempColor.b;
          col1[offset + 3] = tempColor.r; col1[offset + 4] = tempColor.g; col1[offset + 5] = tempColor.b;

          pos2[offset] = vA.posL2.x; pos2[offset + 1] = vA.posL2.y; pos2[offset + 2] = vA.posL2.z;
          pos2[offset + 3] = vB.posL2.x; pos2[offset + 4] = vB.posL2.y; pos2[offset + 5] = vB.posL2.z;
          const wave2 = 0.5 + 0.5 * Math.sin(elapsed * 3.8 * dirSign - e * 0.18 + params.nextLayerPhase);
          tempColor.setHSL(0.76 + wave2 * 0.10, 0.95, (0.32 + wave2 * 0.35) * coupling);
          col2[offset] = tempColor.r; col2[offset + 1] = tempColor.g; col2[offset + 2] = tempColor.b;
          col2[offset + 3] = tempColor.r; col2[offset + 4] = tempColor.g; col2[offset + 5] = tempColor.b;

          let alpha1 = ((elapsed * 0.85 * params.wSpeed * dirSign + e * 0.13) % 1 + 1) % 1;
          lerpPulseVec.lerpVectors(vA.posL1, vB.posL1, alpha1);
          dummy.position.copy(lerpPulseVec);
          dummy.rotation.set(0, 0, 0);
          dummy.scale.setScalar(coupling * launchEase);
          dummy.updateMatrix();
          geoPulseMesh.setMatrixAt(e, dummy.matrix);

          let alpha2 = ((elapsed * 0.85 * params.wSpeed * dirSign + e * 0.13 + 0.25) % 1 + 1) % 1;
          lerpPulseVec.lerpVectors(vA.posL2, vB.posL2, alpha2);
          dummy.position.copy(lerpPulseVec);
          dummy.scale.setScalar(coupling * 1.15 * launchEase);
          dummy.updateMatrix();
          geoPulseMesh.setMatrixAt(GEO_EDGE_COUNT + e, dummy.matrix);
        }

        geodesicLinesL1.geometry.attributes.position.needsUpdate = true;
        geodesicLinesL1.geometry.attributes.color.needsUpdate = true;
        geodesicLinesL2.geometry.attributes.position.needsUpdate = true;
        geodesicLinesL2.geometry.attributes.color.needsUpdate = true;
        geoPulseMesh.instanceMatrix.needsUpdate = true;
      }

      const worldProjVec = new THREE.Vector3();
      const clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);

        const dt = Math.max(clock.getDelta(), 0.001);
        const dtMs = Math.min(dt * 1000, 100);
        const elapsed = clock.getElapsedTime();

        // 1. Step 250x Cryptics Fieyld Optics Radial Background
        stepRadialField(dtMs);

        // 2. Step 3D/4D Geodesic Sierpinski-Tesseract Orb
        if (params.launchProgress < 1) {
          params.launchProgress = Math.min(1, params.launchProgress + dt * 1.15);
        }
        const t = params.launchProgress;
        const launchEase = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);

        params.wAngleXW += dt * 0.65 * params.wSpeed;
        params.wAngleYW += dt * 0.45 * params.wSpeed;
        params.wAngleZW += dt * 0.30 * params.wSpeed;

        if (params.autoRotate && !isDragging) {
          targetRotY += dt * 0.24 * (params.negative4D ? -1 : 1);
          targetRotX = Math.sin(elapsed * 0.3) * 0.22;
        }
        currentRotX += (targetRotX - currentRotX) * 0.08;
        currentRotY += (targetRotY - currentRotY) * 0.08;

        masterGroup.rotation.x = currentRotX;
        masterGroup.rotation.y = currentRotY;
        masterGroup.scale.setScalar(0.05 + 0.95 * launchEase);

        const ratio = params.layerRatio;
        const layer1Cap = params.maxCircleRadius;
        const layer2Cap = params.maxCircleRadius * ratio;

        const ovalScaleVec1 = computeOvalScaleVec(elapsed, 0);
        const ovalScaleVec2 = computeOvalScaleVec(elapsed, params.nextLayerPhase);

        capCircleGroup1.scale.setScalar(layer1Cap);
        capCircleGroup2.scale.setScalar(layer2Cap);

        const baseOvalR1 = layer1Cap * 0.85;
        ovalRing1A.scale.set(Math.min(layer1Cap, baseOvalR1 * ovalScaleVec1.x), Math.min(layer1Cap, baseOvalR1 * ovalScaleVec1.y), 1);
        ovalRing1A.rotation.z = elapsed * 0.3;
        ovalRing1B.scale.set(Math.min(layer1Cap, baseOvalR1 * ovalScaleVec1.z), Math.min(layer1Cap, baseOvalR1 * ovalScaleVec1.y), 1);
        ovalRing1B.rotation.x = elapsed * 0.25;

        const baseOvalR2 = layer2Cap * 0.85;
        ovalRing2A.scale.set(Math.min(layer2Cap, baseOvalR2 * ovalScaleVec2.x), Math.min(layer2Cap, baseOvalR2 * ovalScaleVec2.y), 1);
        ovalRing2A.rotation.z = -elapsed * 0.25;
        ovalRing2B.scale.set(Math.min(layer2Cap, baseOvalR2 * ovalScaleVec2.z), Math.min(layer2Cap, baseOvalR2 * ovalScaleVec2.y), 1);
        ovalRing2B.rotation.x = -elapsed * 0.20;

        updateGeodesicLattice(elapsed, layer1Cap, layer2Cap, ovalScaleVec1, ovalScaleVec2, launchEase);

        if (fractalMesh && duplicateShellMesh && latticeLines) {
          const uniformFacePulse = 1 + Math.sin(elapsed * 2.4) * 0.035;
          for (let i = 0; i < fractalNodes.length; i++) {
            const node = fractalNodes[i];
            node.currentPos.lerpVectors(node.cubeVec, node.sphereVec, params.morph);
            node.currentPos.x *= (1 + (ovalScaleVec1.x - 1) * 0.22) * uniformFacePulse;
            node.currentPos.y *= (1 + (ovalScaleVec1.y - 1) * 0.22) * uniformFacePulse;
            node.currentPos.z *= (1 + (ovalScaleVec1.z - 1) * 0.22) * uniformFacePulse;
            const d = node.currentPos.length();
            if (d > layer1Cap * 0.90) node.currentPos.multiplyScalar((layer1Cap * 0.90) / d);
            dummy.position.copy(node.currentPos);
            dummy.rotation.set(0, 0, 0);
            dummy.scale.setScalar(node.baseSize * launchEase);
            dummy.updateMatrix();
            fractalMesh.setMatrixAt(i, dummy.matrix);
          }
          fractalMesh.instanceMatrix.needsUpdate = true;

          for (let i = 0; i < outerShellNodes.length; i++) {
            const node = outerShellNodes[i];
            dummy.position.copy(node.currentPos).multiplyScalar(ratio);
            dummy.rotation.set(elapsed * 0.5, elapsed * 0.5, 0);
            dummy.scale.setScalar(node.baseSize * 0.65 * launchEase);
            dummy.updateMatrix();
            duplicateShellMesh.setMatrixAt(i, dummy.matrix);
          }
          duplicateShellMesh.instanceMatrix.needsUpdate = true;

          const segPosArr = latticeLines.geometry.attributes.position.array;
          const segColArr = latticeLines.geometry.attributes.color.array;
          for (let s = 0; s < latticeSegments.length; s++) {
            const seg = latticeSegments[s];
            const pA = fractalNodes[seg.a].currentPos, pB = fractalNodes[seg.b].currentPos;
            const offset = s * 6;
            segPosArr[offset] = pA.x; segPosArr[offset + 1] = pA.y; segPosArr[offset + 2] = pA.z;
            segPosArr[offset + 3] = pB.x; segPosArr[offset + 4] = pB.y; segPosArr[offset + 5] = pB.z;
            const energy = 0.5 + 0.5 * Math.sin(elapsed * 4.0 - seg.phase);
            tempColor.setHSL(0.52 + seg.axis * 0.14 + energy * 0.08, 0.95, 0.45 + energy * 0.35);
            segColArr[offset] = tempColor.r; segColArr[offset + 1] = tempColor.g; segColArr[offset + 2] = tempColor.b;
            segColArr[offset + 3] = tempColor.r; segColArr[offset + 4] = tempColor.g; segColArr[offset + 5] = tempColor.b;
          }
          latticeLines.geometry.attributes.position.needsUpdate = true;
          latticeLines.geometry.attributes.color.needsUpdate = true;
        }

        const projectedLayer1 = tesseractPointRegistry.map(reg => projectEncoded4Dto3D(reg.v4, ovalScaleVec1, 1.0, 0));
        const projectedLayer2 = tesseractPointRegistry.map(reg => projectEncoded4Dto3D(reg.v4, ovalScaleVec2, ratio, params.nextLayerPhase));

        for (let i = 0; i < 16; i++) {
          const reg = tesseractPointRegistry[i];
          reg.velL1 = projectedLayer1[i].distanceTo(reg.prevL1) / dt;
          reg.velL2 = projectedLayer2[i].distanceTo(reg.prevL2) / dt;
          reg.prevL1.copy(projectedLayer1[i]);
          reg.prevL2.copy(projectedLayer2[i]);
        }

        updateTesseractEdgeBuffer(tesseractLines.geometry, projectedLayer1, layer1Cap, elapsed, 0.50);
        updateTesseractEdgeBuffer(dupTesseractLines.geometry, projectedLayer2, layer2Cap, elapsed, 0.74);

        const bridgePosArr = anchorBridgeGeo.attributes.position.array;
        const bridgeColArr = anchorBridgeGeo.attributes.color.array;
        for (let i = 0; i < 16; i++) {
          const p1 = projectedLayer1[i], p2 = projectedLayer2[i];
          const offset = i * 6;
          bridgePosArr[offset] = p1.x; bridgePosArr[offset + 1] = p1.y; bridgePosArr[offset + 2] = p1.z;
          bridgePosArr[offset + 3] = p2.x; bridgePosArr[offset + 4] = p2.y; bridgePosArr[offset + 5] = p2.z;
          const isSel = i === params.selectedVertex;
          const pulse = isSel ? 1.0 : 0.5 + 0.5 * Math.sin(elapsed * 4.5 - i * 0.4);
          tempColor.setHSL(0.52, 1.0, isSel ? 0.85 : 0.55 + pulse * 0.2);
          bridgeColArr[offset] = tempColor.r; bridgeColArr[offset + 1] = tempColor.g; bridgeColArr[offset + 2] = tempColor.b;
          tempColor.setHSL(0.82, 1.0, isSel ? 0.85 : 0.55 + pulse * 0.2);
          bridgeColArr[offset + 3] = tempColor.r; bridgeColArr[offset + 4] = tempColor.g; bridgeColArr[offset + 5] = tempColor.b;
        }
        anchorBridgeGeo.attributes.position.needsUpdate = true;
        anchorBridgeGeo.attributes.color.needsUpdate = true;

        const tPosArr = trailGeo.attributes.position.array;
        const tColArr = trailGeo.attributes.color.array;
        let trailPtr = 0;
        for (let i = 0; i < TOTAL_VERTICES; i++) {
          const isLayer2 = i >= 16;
          const baseIdx = isLayer2 ? i - 16 : i;
          const pt = isLayer2 ? projectedLayer2[baseIdx] : projectedLayer1[baseIdx];
          const isSel = baseIdx === params.selectedVertex;

          dummy.position.copy(pt);
          dummy.rotation.set(0, 0, 0);
          dummy.scale.setScalar((isLayer2 ? 1.15 : 0.95) * (isSel ? 1.55 : 1.0));
          dummy.updateMatrix();
          tesseractNodesMesh.setMatrixAt(i, dummy.matrix);

          const hist = vertexHistory[i];
          hist.unshift(pt.clone());
          if (hist.length > TRAIL_LENGTH) hist.pop();

          const baseHue = isLayer2 ? 0.78 : 0.52;
          for (let h = 0; h < TRAIL_LENGTH - 1; h++) {
            const p0 = hist[h] || pt, p1 = hist[h + 1] || p0;
            const fade = 1 - h / (TRAIL_LENGTH - 1);
            tPosArr[trailPtr] = p0.x; tPosArr[trailPtr + 1] = p0.y; tPosArr[trailPtr + 2] = p0.z;
            tPosArr[trailPtr + 3] = p1.x; tPosArr[trailPtr + 4] = p1.y; tPosArr[trailPtr + 5] = p1.z;
            tempColor.setHSL((baseHue + (1 - fade) * 0.22) % 1.0, 0.95, 0.55 * fade);
            tColArr[trailPtr] = tempColor.r; tColArr[trailPtr + 1] = tempColor.g; tColArr[trailPtr + 2] = tempColor.b;
            const fadeNext = Math.max(0, 1 - (h + 1) / (TRAIL_LENGTH - 1));
            tempColor.setHSL((baseHue + (1 - fadeNext) * 0.22) % 1.0, 0.95, 0.55 * fadeNext);
            tColArr[trailPtr + 3] = tempColor.r; tColArr[trailPtr + 4] = tempColor.g; tColArr[trailPtr + 5] = tempColor.b;
            trailPtr += 6;
          }
        }
        tesseractNodesMesh.instanceMatrix.needsUpdate = true;
        trailGeo.attributes.position.needsUpdate = true;
        trailGeo.attributes.color.needsUpdate = true;

        // 3. Update Telemetry HUD & 3D Projected Reticle
        const selIdx = params.selectedVertex;
        const selReg = tesseractPointRegistry[selIdx];
        const selP1 = projectedLayer1[selIdx], selP2 = projectedLayer2[selIdx];

        beaconL1.position.copy(selP1); beaconL1.lookAt(camera.position);
        beaconL2.position.copy(selP2); beaconL2.lookAt(camera.position);

        let nearestGeo = geodesicTopology.vertices[0], bestGeoDistSq = Infinity;
        for (let g = 0; g < GEO_VERT_COUNT; g++) {
          const dSq = geodesicTopology.vertices[g].posL2.distanceToSquared(selP2);
          if (dSq < bestGeoDistSq) { bestGeoDistSq = dSq; nearestGeo = geodesicTopology.vertices[g]; }
        }

        let nearestSierpinski = fractalNodes[0], bestSierpDistSq = Infinity;
        for (let k = 0; k < fractalNodes.length; k++) {
          const dSq = fractalNodes[k].currentPos.distanceToSquared(selP1);
          if (dSq < bestSierpDistSq) { bestSierpDistSq = dSq; nearestSierpinski = fractalNodes[k]; }
        }

        if (params.showMarkers) {
          worldProjVec.copy(selP2);
          masterGroup.localToWorld(worldProjVec);
          worldProjVec.project(camera);
          reticleEl.style.left = `${((worldProjVec.x * 0.5 + 0.5) * window.innerWidth).toFixed(1)}px`;
          reticleEl.style.top = `${((-(worldProjVec.y * 0.5) + 0.5) * window.innerHeight).toFixed(1)}px`;
          reticleEl.textContent = `${selReg.code} [${params.negative4D ? '-4D' : '+4D'}:${selReg.binary}] • ${nearestGeo.code} (${selP2.x.toFixed(2)}, ${selP2.y.toFixed(2)}, ${selP2.z.toFixed(2)})`;
        }

        const pct = fieldState.totalCells > 0 ? Math.round((fieldState.activeCount / fieldState.totalCells) * 100) : 0;
        const sec = (fieldState.phaseElapsedMs / 1000).toFixed(1);
        const dirLabel = fieldState.phase === 1 ? 'FILL' : 'INV';
        document.getElementById('enc-field-pct').textContent = `${dirLabel} · ${pct}% · ${sec}s`;
        document.getElementById('fieldStatsLine').textContent =
          `250x Radial Optic Field (${fieldState.activeCount.toLocaleString()} / ${fieldState.totalCells.toLocaleString()} · ${pct}%) · Continuous Runtime`;

        document.getElementById('enc-ratio-cap').textContent = `${ratio.toFixed(2)}x | R${layer1Cap.toFixed(2)}→${layer2Cap.toFixed(2)}`;
        document.getElementById('enc-l1-pos').textContent = `${selP1.x.toFixed(2)}, ${selP1.y.toFixed(2)}, ${selP1.z.toFixed(2)} (r=${selP1.length().toFixed(2)})`;
        document.getElementById('enc-l2-pos').textContent = `${selP2.x.toFixed(2)}, ${selP2.y.toFixed(2)}, ${selP2.z.toFixed(2)} (r=${selP2.length().toFixed(2)})`;
        document.getElementById('enc-span-vel').textContent = `Δr ${selP1.distanceTo(selP2).toFixed(2)} | ${selReg.velL2.toFixed(2)} u/s`;
        document.getElementById('enc-geo-space').textContent = `${nearestGeo.code} • ${nearestSierpinski ? nearestSierpinski.encodedAddress : 'S000000'}`;

        coreLight.intensity = 3.0 + Math.sin(elapsed * 4) * 0.8;
        renderer.render(scene, camera);
      }

      animate();
    };
  </script>
