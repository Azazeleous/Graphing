          flash.style.opacity = '0';
        });
      }

      initRadialField();
      buildFractalOrb(params.depth);
      triggerLaunch();

      // =========================================================================
      // PART 4: ORBIT CONTROLS, SPROCKET POPOUT UI & TERMINAL HANDLERS
      // =========================================================================
      let isDragging = false, prevPointer = { x: 0, y: 0 };
