      masterGroup.add(tesseractNodesMesh);

      // Circumference Cap Circles & Oval Diameter Rings
      function createCircleLoop(segments) {
        const pts = [];
        for (let i = 0; i <= segments; i++) {
          const theta = (i / segments) * Math.PI * 2;
          pts.push(new THREE.Vector3(Math.cos(theta), Math.sin(theta), 0));
        }
        return new THREE.BufferGeometry().setFromPoints(pts);
      }

      const capCircleGroup1 = new THREE.Group();
      const capMat1 = new THREE.LineBasicMaterial({ color: 0x00f3ff, transparent: true, opacity: 0.28, blending: THREE.AdditiveBlending });
      const c1XY = new THREE.Line(createCircleLoop(128), capMat1);
      const c1XZ = new THREE.Line(createCircleLoop(128), capMat1); c1XZ.rotation.x = Math.PI / 2;
      const c1YZ = new THREE.Line(createCircleLoop(128), capMat1); c1YZ.rotation.y = Math.PI / 2;
      capCircleGroup1.add(c1XY, c1XZ, c1YZ);

      const capCircleGroup2 = new THREE.Group();
      const capMat2 = new THREE.LineBasicMaterial({ color: 0xa855f7, transparent: true, opacity: 0.24, blending: THREE.AdditiveBlending });
      const c2XY = new THREE.Line(createCircleLoop(128), capMat2);
      const c2XZ = new THREE.Line(createCircleLoop(128), capMat2); c2XZ.rotation.x = Math.PI / 2;
      const c2YZ = new THREE.Line(createCircleLoop(128), capMat2); c2YZ.rotation.y = Math.PI / 2;
      capCircleGroup2.add(c2XY, c2XZ, c2YZ);

      const ovalMat1 = new THREE.LineBasicMaterial({ color: 0xff44cc, transparent: true, opacity: 0.52, blending: THREE.AdditiveBlending });
      const ovalRing1A = new THREE.Line(createCircleLoop(128), ovalMat1);
      const ovalRing1B = new THREE.Line(createCircleLoop(128), ovalMat1); ovalRing1B.rotation.y = Math.PI / 2;

      const ovalMat2 = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.45, blending: THREE.AdditiveBlending });
      const ovalRing2A = new THREE.Line(createCircleLoop(128), ovalMat2);
      const ovalRing2B = new THREE.Line(createCircleLoop(128), ovalMat2); ovalRing2B.rotation.y = Math.PI / 2;

      masterGroup.add(capCircleGroup1, capCircleGroup2, ovalRing1A, ovalRing1B, ovalRing2A, ovalRing2B);

      function computeOvalScaleVec(elapsed, phaseOffset) {
        const amp = params.ovalAmplitude;
        return new THREE.Vector3(
          1 + Math.sin(elapsed * 2.1 + phaseOffset) * amp,
          1 + Math.cos(elapsed * 2.1 + phaseOffset) * amp,
          1 + Math.sin(elapsed * 2.1 + phaseOffset + Math.PI * 0.5) * (amp * 0.75)
        );
      }

      function projectEncoded4Dto3D(v4, ovalScaleVec, layerScaleMultiplier, wPhaseShift) {
        const s = params.negative4D ? -1 : 1;
        let x = v4[0] * s, y = v4[1] * s, z = v4[2] * s, w = v4[3] * s;

        const aXW = (params.wAngleXW + wPhaseShift) * s;
        let nx = x * Math.cos(aXW) - w * Math.sin(aXW);
        let nw = x * Math.sin(aXW) + w * Math.cos(aXW);
        x = nx; w = nw;

        const aYW = (params.wAngleYW + wPhaseShift * 0.7) * s;
        let ny = y * Math.cos(aYW) - w * Math.sin(aYW);
        nw = y * Math.sin(aYW) + w * Math.cos(aYW);
        y = ny; w = nw;

        const aZW = (params.wAngleZW + wPhaseShift * 0.5) * s;
        let nz = z * Math.cos(aZW) - w * Math.sin(aZW);
        nw = z * Math.sin(aZW) + w * Math.cos(aZW);
        z = nz; w = nw;

        const denom = params.negative4D ? (params.wDistance + w) : (params.wDistance - w);
        const wFactor = 1 / Math.max(0.85, denom);
        const baseScale = 2.4 * layerScaleMultiplier;
        const projVec = new THREE.Vector3(x * wFactor * baseScale, y * wFactor * baseScale, z * wFactor * baseScale);

        projVec.multiply(ovalScaleVec);

        const layerCapRadius = params.maxCircleRadius * layerScaleMultiplier;
        const sphereShell = projVec.clone().normalize().multiplyScalar(layerCapRadius * 0.86);
        projVec.lerp(sphereShell, params.morph * 0.65);

        const dist = projVec.length();
        if (dist > layerCapRadius) projVec.multiplyScalar(layerCapRadius / dist);
        return projVec;
      }

      function triggerLaunch() {
        params.launchProgress = 0.01;
        for (let i = 0; i < TOTAL_VERTICES; i++) vertexHistory[i].length = 0;
        const flash = document.getElementById('launch-flash');
