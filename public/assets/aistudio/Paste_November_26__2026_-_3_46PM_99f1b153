      const beaconGeo = new THREE.RingGeometry(0.14, 0.20, 24);
      const beaconL1 = new THREE.Mesh(beaconGeo, new THREE.MeshBasicMaterial({ color: 0x00f3ff, side: THREE.DoubleSide, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending }));
      const beaconL2 = new THREE.Mesh(beaconGeo, new THREE.MeshBasicMaterial({ color: 0xff44cc, side: THREE.DoubleSide, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending }));
      masterGroup.add(beaconL1, beaconL2);

      const TOTAL_VERTICES = 32;
