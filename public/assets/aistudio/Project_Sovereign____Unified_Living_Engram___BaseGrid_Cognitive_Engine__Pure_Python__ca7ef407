class RosesQuantumTransform:
   """
   ROSE-Q: Exact Reversible Modular Affine Transform:
     Forward: c = (131 * b + k) mod 256
     Inverse: b = (43 * (c - k)) mod 256   [131 * 43 = 5633 ≡ 1 mod 256]
     Guarantees D(E(x)) = x and Delta_forward + Delta_inverse = 0.
   """
   VERSION = "ROSE-Q-v2.2"
   MULTIPLIER = 131
   MOD_INVERSE = 43

   @staticmethod
   def _derive_keystream(seed_bytes: bytes, length: int) -> bytes:
       stream = bytearray()
       counter = 0
       while len(stream) < length:
           stream.extend(hashlib.sha256(seed_bytes + struct.pack(">I", counter)).digest())
           counter += 1
       return bytes(stream[:length])

   def apply(self, raw_bytes: bytes, csprng_nonce: bytes) -> dict[str, Any]:
       keystream = self._derive_keystream(csprng_nonce, len(raw_bytes))
       transformed = bytes(((b * self.MULTIPLIER) + k) & 0xFF for b, k in zip(raw_bytes, keystream))
       delta_forward = sum(c - b for b, c in zip(raw_bytes, transformed))
       digest = hashlib.sha256(transformed).digest()
       u16_symbol = struct.unpack(">H", digest[:2])[0]
       u16_complement = struct.unpack(">H", digest[2:4])[0]
       return {
           "version": self.VERSION,
           "transformed_bytes": transformed,
           "original_length": len(raw_bytes),
           "delta_forward": delta_forward,
           "u16_symbol": u16_symbol,
           "u16_complement": u16_complement,
       }

   def inverse(self, transformed_bytes: bytes, csprng_nonce: bytes) -> bytes:
       keystream = self._derive_keystream(csprng_nonce, len(transformed_bytes))
       return bytes(((c - k) * self.MOD_INVERSE) & 0xFF for c, k in zip(transformed_bytes, keystream))

   def verify_symmetry(self, raw_bytes: bytes, csprng_nonce: bytes) -> dict[str, Any]:
       fwd = self.apply(raw_bytes, csprng_nonce)
       recovered = self.inverse(fwd["transformed_bytes"], csprng_nonce)
       delta_inverse = sum(r - c for c, r in zip(fwd["transformed_bytes"], recovered))
       delta_sum = fwd["delta_forward"] + delta_inverse
       return {
           "delta_sum": delta_sum,
           "exact_identity": (recovered == raw_bytes) and (delta_sum == 0),
       }


