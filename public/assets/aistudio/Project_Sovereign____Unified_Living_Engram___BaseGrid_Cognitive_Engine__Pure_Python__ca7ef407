def apply_rope(vec: list[float], pos: int, base: float = 10000.0) -> list[float]:
   d = len(vec)
   rotated = list(vec)
   for i in range(0, d - 1, 2):
       theta = pos / (base ** (i / d))
       cos_t, sin_t = math.cos(theta), math.sin(theta)
       x0, x1 = vec[i], vec[i + 1]
       rotated[i] = x0 * cos_t - x1 * sin_t
       rotated[i + 1] = x0 * sin_t + x1 * cos_t
   return rotated


class MultiHeadAttention(Module):
   """Causal Multi-Head Self-Attention with Rotary Position Embeddings (RoPE)."""
   def __init__(self, d_model: int, n_heads: int):
       super().__init__()
       assert d_model % n_heads == 0
       self.d_model = d_model
       self.n_heads = n_heads
       self.d_k = d_model // n_heads
       self.w_q = Linear(d_model, d_model, bias=False)
       self.w_k = Linear(d_model, d_model, bias=False)
       self.w_v = Linear(d_model, d_model, bias=False)
       self.w_o = Linear(d_model, d_model, bias=False)

   def forward(self, x: list[list[list[float]]], causal: bool = True) -> list[list[list[float]]]:
       batch_size = len(x)
       seq_len = len(x[0])
       q, k, v = self.w_q(x), self.w_k(x), self.w_v(x)
       scale = 1.0 / math.sqrt(self.d_k)
       concat_heads = [[[0.0] * self.d_model for _ in range(seq_len)] for _ in range(batch_size)]

       for b in range(batch_size):
           for h in range(self.n_heads):
               start, end = h * self.d_k, (h + 1) * self.d_k
               q_h = [apply_rope(q[b][t][start:end], t) for t in range(seq_len)]
               k_h = [apply_rope(k[b][t][start:end], t) for t in range(seq_len)]
               v_h = [v[b][t][start:end] for t in range(seq_len)]

               for i in range(seq_len):
                   scores = [
                       float("-inf") if (causal and j > i)
                       else sum(q_h[i][d] * k_h[j][d] for d in range(self.d_k)) * scale
                       for j in range(seq_len)
                   ]
                   weights = softmax(scores)
                   for d in range(self.d_k):
                       concat_heads[b][i][start + d] = sum(weights[j] * v_h[j][d] for j in range(seq_len))

       return self.w_o(concat_heads)


