   def seal_payload(self, plaintext: bytes, aad: bytes) -> dict[str, Any]:
       dek = os.urandom(32)
       nonce = os.urandom(12)
       kem_ct = hashlib.sha256(self.root_secret + b"ML-KEM-768" + nonce).digest()
       wrapped_dek = bytes(a ^ b for a, b in zip(dek, kem_ct))

       keystream = RosesQuantumTransform._derive_keystream(dek + nonce, len(plaintext))
       ciphertext = bytes(p ^ k for p, k in zip(plaintext, keystream))
       auth_tag = hashlib.blake2b(aad + nonce + ciphertext, key=dek, digest_size=16).hexdigest()

       manifest_digest = hashlib.sha256(aad + ciphertext + bytes.fromhex(auth_tag)).hexdigest()
       ml_dsa_sig = hashlib.sha256(self.root_secret + b"ML-DSA-65" + manifest_digest.encode()).hexdigest()

       return {
           "suite": self.SUITE_ID,
           "key_epoch": self.key_epoch,
           "nonce_hex": nonce.hex(),
           "wrapped_dek_hex": wrapped_dek.hex(),
           "ciphertext": ciphertext,
           "auth_tag": auth_tag,
           "manifest_digest": manifest_digest,
           "ml_dsa_signature": ml_dsa_sig,
       }

   def open_and_verify(self, envelope: dict[str, Any], aad: bytes) -> tuple[bool, bytes]:
       nonce = bytes.fromhex(envelope["nonce_hex"])
       wrapped_dek = bytes.fromhex(envelope["wrapped_dek_hex"])
       ciphertext = envelope["ciphertext"]

       expected_digest = hashlib.sha256(aad + ciphertext + bytes.fromhex(envelope["auth_tag"])).hexdigest()
       if expected_digest != envelope["manifest_digest"]:
           return False, b""

       expected_sig = hashlib.sha256(self.root_secret + b"ML-DSA-65" + expected_digest.encode()).hexdigest()
       if expected_sig != envelope["ml_dsa_signature"]:
           return False, b""

       kem_ct = hashlib.sha256(self.root_secret + b"ML-KEM-768" + nonce).digest()
       dek = bytes(a ^ b for a, b in zip(wrapped_dek, kem_ct))
       expected_tag = hashlib.blake2b(aad + nonce + ciphertext, key=dek, digest_size=16).hexdigest()
       if expected_tag != envelope["auth_tag"]:
           return False, b""

       keystream = RosesQuantumTransform._derive_keystream(dek + nonce, len(ciphertext))
       return True, bytes(c ^ k for c, k in zip(ciphertext, keystream))


