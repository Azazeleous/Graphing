class GF256:
   """Exact Galois Field GF(2^8) arithmetic with primitive polynomial 0x11D."""
   EXP = [0] * 512
   LOG = [0] * 256

   _x = 1
   for _i in range(255):
       EXP[_i] = _x
       LOG[_x] = _i
       _x <<= 1
       if _x & 0x100:
           _x ^= 0x11D
   for _i in range(255, 512):
       EXP[_i] = EXP[_i - 255]

   @staticmethod
   def add(a: int, b: int) -> int:
       return a ^ b

   @staticmethod
   def mul(a: int, b: int) -> int:
       if a == 0 or b == 0:
           return 0
       return GF256.EXP[GF256.LOG[a] + GF256.LOG[b]]

   @staticmethod
   def div(a: int, b: int) -> int:
       if b == 0:
           raise ZeroDivisionError("GF(256) division by zero")
       if a == 0:
           return 0
       return GF256.EXP[(GF256.LOG[a] - GF256.LOG[b]) % 255]

   @staticmethod
   def inv(a: int) -> int:
       if a == 0:
           raise ZeroDivisionError("GF(256) inverse of zero")
       return GF256.EXP[255 - GF256.LOG[a]]

   @staticmethod
   def power(a: int, exponent: int) -> int:
       if exponent == 0:
           return 1
       if a == 0:
           return 0
       return GF256.EXP[(GF256.LOG[a] * exponent) % 255]


def gf_eval(coefficients: list[int], x: int) -> int:
   result = 0
   for coefficient in coefficients:
       result = GF256.mul(result, x) ^ coefficient
   return result


def gf_solve(A: list[list[int]], b: list[int]) -> list[int] | None:
   if not A:
       return []
   matrix = [list(row) + [value] for row, value in zip(A, b)]
   rows = len(matrix)
   columns = len(matrix[0]) - 1
   pivot_columns = []
   pivot_row = 0

   for col in range(columns):
       pivot = next((i for i in range(pivot_row, rows) if matrix[i][col]), None)
       if pivot is None:
           continue
       matrix[pivot_row], matrix[pivot] = matrix[pivot], matrix[pivot_row]
       inverse = GF256.inv(matrix[pivot_row][col])
       matrix[pivot_row] = [GF256.mul(value, inverse) for value in matrix[pivot_row]]

       for row in range(rows):
           if row == pivot_row:
               continue
           factor = matrix[row][col]
           if factor:
               matrix[row] = [
                   a ^ GF256.mul(factor, bv)
                   for a, bv in zip(matrix[row], matrix[pivot_row])
               ]
       pivot_columns.append(col)
       pivot_row += 1

   for row in matrix:
       if not any(row[:columns]) and row[columns]:
           return None
   if len(pivot_columns) < columns:
       return None

   solution = [0] * columns
   for row, col in enumerate(pivot_columns):
       solution[col] = matrix[row][columns]
   return solution


def rs_encode(message: bytes, n: int | None = None) -> bytes:
   """Systematic/evaluation Reed-Solomon encoder over GF(256)."""
   n = n or 255
   k = len(message)
   if not 1 <= k <= n <= 255:
       raise ValueError("Invalid Reed-Solomon block dimensions")

   vandermonde = [
       [GF256.power(i + 1, k - j - 1) for j in range(k)]
       for i in range(k)
   ]
   coefficients = gf_solve(vandermonde, list(message))
   if coefficients is None:
       raise ValueError("RS Vandermonde interpolation failure")
   return bytes(gf_eval(coefficients, i + 1) for i in range(n))


def rs_decode_bw(codeword: bytes, k: int, max_errors: int | None = None, erasures: tuple[int, ...] = ()) -> dict[str, Any]:
   """Berlekamp-Welch algebraic Reed-Solomon decoder over GF(256)."""
   n = len(codeword)
   erased = set(erasures)
   if any(i < 0 or i >= n for i in erased):
       raise ValueError("Erasure index out of range")

   available = [i for i in range(n) if i not in erased]
   t = (len(available) - k) // 2 if max_errors is None else int(max_errors)
   if t < 0 or 2 * t + len(erased) > n - k:
       raise ValueError("Singleton/BW bound 2e + s <= n - k violated")

   q_degree = k + t
   A, b = [], []
   for index in available:
       x = index + 1
       y = codeword[index]
       row = [GF256.power(x, q_degree - j - 1) for j in range(q_degree)]
       row += [GF256.mul(y, GF256.power(x, t - j - 1)) for j in range(t)]
       A.append(row)
       b.append(GF256.mul(y, GF256.power(x, t)))

   solution = gf_solve(A, b)
   if solution is None:
       raise ValueError("Berlekamp-Welch linear system singular or inconsistent")

   q = solution[:q_degree]
   locator = solution[q_degree:] + [1]
   remainder = list(q)
   coefficients = [0] * k

   for position in range(k):
       leading = remainder[position]
       coefficients[position] = leading
       if leading:
           for j in range(t + 1):
               remainder[position + j] ^= GF256.mul(leading, locator[j])

   if any(remainder):
       raise ValueError("Non-exact polynomial division in Berlekamp-Welch")

   decoded = bytes(gf_eval(coefficients, i + 1) for i in range(n))
   errors = [
       i for i, (a, bv) in enumerate(zip(decoded, codeword))
       if a != bv and i not in erased
   ]
   if len(errors) > t:
       raise ValueError("Error correction capacity exceeded")

   return {
       "message": decoded[:k],
       "codeword": decoded,
       "errors": errors,
       "erasures": sorted(erased),
   }


def _gf2_degree(poly: int) -> int:
   return poly.bit_length() - 1


def _gf2_mod(dividend: int, divisor: int) -> int:
   if divisor == 0:
       raise ZeroDivisionError("GF(2) division by zero")
   while dividend and _gf2_degree(dividend) >= _gf2_degree(divisor):
       dividend ^= divisor << (_gf2_degree(dividend) - _gf2_degree(divisor))
   return dividend


def _gf2_mul_mod(a: int, b: int, modulus: int) -> int:
   result = 0
   while b:
       if b & 1:
           result ^= a
       b >>= 1
       a <<= 1
       if a & (1 << _gf2_degree(modulus)):
           a ^= modulus
   return result


def _gf2_pow_mod(a: int, exponent: int, modulus: int) -> int:
   result = 1
   while exponent:
       if exponent & 1:
           result = _gf2_mul_mod(result, a, modulus)
       a = _gf2_mul_mod(a, a, modulus)
       exponent >>= 1
   return result


class BCHCodec:
   """Binary primitive narrow-sense BCH encoder/decoder with Berlekamp-Massey solver."""
   def __init__(self, m: int = 4, t: int = 1, primitive_polynomial: int = 0b10011):
       self.m = m
       self.t = t
       self.primitive = primitive_polynomial
       self.n = (1 << m) - 1
       if _gf2_degree(primitive_polynomial) != m:
           raise ValueError("Primitive polynomial degree mismatch")
       self.generator = self._build_generator()
       self.r = _gf2_degree(self.generator)
       self.k = self.n - self.r

   def _alpha(self, exponent: int) -> int:
       return _gf2_pow_mod(0b10, exponent % self.n, self.primitive)

   def _minimal_polynomial(self, exponent: int) -> int:
       coset = []
       val = exponent % self.n
       while val not in coset:
           coset.append(val)
           val = (val * 2) % self.n
       poly = [1]
       for root_pow in coset:
           root = self._alpha(root_pow)
           nxt = [0] * (len(poly) + 1)
           for i, coeff in enumerate(poly):
               nxt[i] ^= GF256.mul(coeff, root)
               nxt[i + 1] ^= coeff
           poly = nxt
       res = 0
       for i, coeff in enumerate(poly):
           res |= (coeff & 1) << i
       return res

   @staticmethod
   def _poly_mul(a: int, b: int) -> int:
       res = 0
       while b:
           if b & 1:
               res ^= a
           a <<= 1
           b >>= 1
       return res

   def _build_generator(self) -> int:
       gen = 1
       used = set()
       for root in range(1, 2 * self.t + 1):
           coset = set()
           val = root % self.n
           while val not in coset:
               coset.add(val)
               val = (val * 2) % self.n
           if coset & used:
               continue
           used |= coset
           gen = self._poly_mul(gen, self._minimal_polynomial(root))
       return gen

   def encode(self, message: int) -> int:
       if message < 0 or message >= (1 << self.k):
           raise ValueError("Message out of BCH range")
       shifted = message << self.r
       return shifted ^ _gf2_mod(shifted, self.generator)

   def syndrome(self, codeword: int) -> list[int]:
       return [_gf2_pow_mod(codeword, i, self.primitive) for i in range(1, 2 * self.t + 1)]

   def decode(self, codeword: int) -> dict[str, Any]:
       syndromes = self.syndrome(codeword)
       if not any(syndromes):
           return {"codeword": codeword, "message": codeword >> self.r, "errors": [], "corrected": True}

       C = [1] + [0] * (2 * self.t)
       B = [1] + [0] * (2 * self.t)
       L, shift, disc_scale = 0, 1, 1

       for n in range(2 * self.t):
           disc = syndromes[n]
           for i in range(1, L + 1):
               disc ^= GF256.mul(C[i], syndromes[n - i])
           if disc == 0:
               shift += 1
               continue
           old = C[:]
           factor = GF256.div(disc, disc_scale)
           for i in range(2 * self.t + 1 - shift):
               if B[i]:
                   C[i + shift] ^= GF256.mul(factor, B[i])
           if 2 * L <= n:
               L = n + 1 - L
               B = old
               disc_scale = disc
               shift = 1
           else:
               shift += 1

       if L > self.t:
           raise ValueError("BCH correction capacity exceeded")

       error_positions = []
       for pos in range(self.n):
           x = GF256.power(2, pos)
           val = 0
           for coeff in reversed(C[:L + 1]):
               val = GF256.mul(val, x) ^ coeff
           if val == 0:
               error_positions.append(pos)

       corrected = codeword
       for pos in error_positions:
           corrected ^= 1 << pos

       if any(self.syndrome(corrected)):
           raise ValueError("BCH post-correction syndrome non-zero")

       return {
           "codeword": corrected,
           "message": corrected >> self.r,
           "errors": error_positions,
           "corrected": True,
       }


