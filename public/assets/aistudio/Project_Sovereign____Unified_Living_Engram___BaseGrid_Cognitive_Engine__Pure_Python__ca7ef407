       """Appends a LivingEngram into the immutable hash-chained fabric."""
       chain_material = (
           f"{self.head_hash}|{engram.engram_id}|"
           f"{engram.integrity['record_digest']}|{engram.ecc_verification['sha256']}"
       ).encode("utf-8")
       commitment = hashlib.sha256(chain_material).hexdigest()
       engram.integrity["previous_commitment"] = self.head_hash
       engram.integrity["ledger_commitment"] = commitment
       self.head_hash = commitment

       self.engrams.append(engram)
       self.update_constellations()

       if self.persist_path:
           try:
               with open(self.persist_path, "a", encoding="utf-8") as fh:
                   fh.write(json.dumps(asdict(engram), ensure_ascii=False) + "\n")
           except OSError:
               pass

       return commitment

   def verify_chain(self) -> bool:
       prev = "0" * 64
       for eng in self.engrams:
           material = (
               f"{prev}|{eng.engram_id}|"
               f"{eng.integrity['record_digest']}|{eng.ecc_verification['sha256']}"
           ).encode("utf-8")
           recomputed = hashlib.sha256(material).hexdigest()
           if recomputed != eng.integrity.get("ledger_commitment"):
               return False
           prev = recomputed
       return True

   def compute_merkle_root(self) -> str:
       if not self.engrams:
           return self.head_hash
       layer = [e.integrity["ledger_commitment"] for e in self.engrams]
       while len(layer) > 1:
           if len(layer) % 2 == 1:
               layer.append(layer[-1])
           layer = [
               hashlib.sha256((layer[i] + layer[i + 1]).encode("utf-8")).hexdigest()
               for i in range(0, len(layer), 2)
           ]
       return layer[0]

