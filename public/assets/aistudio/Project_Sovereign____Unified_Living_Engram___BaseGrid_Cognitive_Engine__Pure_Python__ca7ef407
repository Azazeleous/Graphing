class DynamicBrainRouter(Module):
   """Token-level Top-K Mixture of Experts with Noisy Gating and Switch Auxiliary Loss."""
   def __init__(self, d_model: int, num_experts: int = 6, experts_per_token: int = 2, d_ff: int | None = None):
       super().__init__()
       self.d_model = d_model
       self.num_experts = num_experts
       self.k = experts_per_token
       d_ff = d_ff or 2 * d_model
       self.gatekeeper = Linear(d_model, num_experts, bias=False)
       self.experts = [SwiGLUExpert(d_model, d_ff) for _ in range(num_experts)]
       self.expert_usage_counts = [0] * num_experts

   def forward(self, x: list[list[list[float]]], training: bool = False) -> tuple[list[list[list[float]]], float]:
       batch_size, seq_len = len(x), len(x[0])
       total_tokens = batch_size * seq_len
       logits = self.gatekeeper(x)
       out = [[[0.0] * self.d_model for _ in range(seq_len)] for _ in range(batch_size)]
       expert_prob_sums = [0.0] * self.num_experts
       expert_token_counts = [0] * self.num_experts

       for b in range(batch_size):
           for t in range(seq_len):
               token_logits = list(logits[b][t])
               if training:
                   token_logits = [l + random.gauss(0.0, 0.05) for l in token_logits]
               full_probs = softmax(token_logits)
               for e_idx in range(self.num_experts):
                   expert_prob_sums[e_idx] += full_probs[e_idx]

               top_k = sorted(enumerate(token_logits), key=lambda pair: pair[1], reverse=True)[:self.k]
               top_weights = softmax([score for _, score in top_k])

               token_slice = [[x[b][t]]]
               for rank_i, (expert_idx, _) in enumerate(top_k):
                   weight = top_weights[rank_i]
                   expert_token_counts[expert_idx] += 1
                   self.expert_usage_counts[expert_idx] += 1
                   expert_out = self.experts[expert_idx](token_slice)[0][0]
                   for d in range(self.d_model):
                       out[b][t][d] += expert_out[d] * weight

       aux_loss = sum(
           (expert_token_counts[i] / max(1, total_tokens * self.k))
           * (expert_prob_sums[i] / max(1, total_tokens))
           for i in range(self.num_experts)
       ) * self.num_experts
       return out, aux_loss


class LoRAAdapter(Module):
   """Low-Rank Adaptation (LoRA) 'Glasses': W + (A @ B) * (alpha / rank)."""
   def __init__(self, d_model: int, rank: int = 4, alpha: float = 8.0):
       super().__init__()
       self.d_model = d_model
       self.rank = rank
       self.scaling = alpha / rank
       self.lora_a = init_matrix(d_model, rank, std=0.05)
       self.lora_b = [[0.0] * d_model for _ in range(rank)]

   def forward(self, x: list[list[list[float]]]) -> list[list[list[float]]]:
       out = []
       for seq in x:
           seq_out = []
           for token in seq:
               bottleneck = [
                   sum(token[d] * self.lora_a[d][r] for d in range(self.d_model))
                   for r in range(self.rank)
               ]
               delta = [
                   sum(bottleneck[r] * self.lora_b[r][d] for r in range(self.rank)) * self.scaling
                   for d in range(self.d_model)
               ]
               seq_out.append(delta)
           out.append(seq_out)
       return out

   def update_weights(self, target_delta: list[float], input_vec: list[float], lr: float):
       if not self.requires_grad:
           raise RuntimeError("Cannot update frozen LoRA adapter")
       bottleneck = [
           sum(input_vec[d] * self.lora_a[d][r] for d in range(self.d_model))
           for r in range(self.rank)
       ]
       for r in range(self.rank):
           for d in range(self.d_model):
               self.lora_b[r][d] += lr * bottleneck[r] * target_delta[d]
               self.lora_a[d][r] += lr * input_vec[d] * target_delta[d] * 0.1

   def parameters(self) -> list:
       return [self.lora_a, self.lora_b]


