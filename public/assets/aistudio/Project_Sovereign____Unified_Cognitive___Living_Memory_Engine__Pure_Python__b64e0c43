class Module:
   """Base class mimicking PyTorch's nn.Module interface with recursive freeze/train state."""
   def __init__(self):
       self.requires_grad = True

   def __call__(self, *args, **kwargs):
       return self.forward(*args, **kwargs)

   def forward(self, *args, **kwargs):
       raise NotImplementedError

   def requires_grad_(self, mode: bool = True):
       self.requires_grad = mode
       for attr in self.__dict__.values():
           if isinstance(attr, Module):
               attr.requires_grad_(mode)
           elif isinstance(attr, list):
               for item in attr:
                   if isinstance(item, Module):
                       item.requires_grad_(mode)
       return self

   def parameters(self) -> list:
       params = []
       for attr in self.__dict__.values():
           if isinstance(attr, Module):
               params.extend(attr.parameters())
           elif isinstance(attr, list):
               for item in attr:
                   if isinstance(item, Module):
                       params.extend(item.parameters())
       return params


def init_matrix(rows: int, cols: int, std: float = 0.04) -> list[list[float]]:
   return [[random.gauss(0.0, std) for _ in range(cols)] for _ in range(rows)]


def init_vector(size: int, fill: float = 0.0) -> list[float]:
   return [fill for _ in range(size)]


def add_tensors(a: list[list[list[float]]], b: list[list[list[float]]]) -> list[list[list[float]]]:
   return [
       [
           [a[i][t][d] + b[i][t][d] for d in range(len(a[0][0]))]
           for t in range(len(a[0]))
       ]
       for i in range(len(a))
   ]


def silu(x: float) -> float:
   """Swish / SiLU activation: x * sigmoid(x)."""
   if x < -60.0:
       return 0.0
   return x / (1.0 + math.exp(-x))


def softmax(logits: list[float]) -> list[float]:
   max_val = max(logits)
   exps = [math.exp(v - max_val) for v in logits]
   sum_exps = sum(exps)
   return [e / sum_exps for e in exps]


def cosine_similarity(v1: list[float], v2: list[float]) -> float:
   dot = sum(a * b for a, b in zip(v1, v2))
   n1 = math.sqrt(sum(a * a for a in v1)) + 1e-8
   n2 = math.sqrt(sum(b * b for b in v2)) + 1e-8
   return dot / (n1 * n2)


def clamp(val: float, lo: float, hi: float) -> float:
   return max(lo, min(hi, val))


def count_parameters(params: list) -> int:
   total = 0
   for p in params:
       if isinstance(p, list):
           if p and isinstance(p[0], list):
               total += sum(len(row) for row in p)
           else:
               total += len(p)
   return total


class Linear(Module):
   """Fully connected linear projection: y = xW + b."""
   def __init__(self, in_features: int, out_features: int, bias: bool = True):
       super().__init__()
       self.in_features = in_features
       self.out_features = out_features
       self.weight = init_matrix(in_features, out_features)
       self.bias = init_vector(out_features, 0.0) if bias else None

   def forward(self, x: list[list[list[float]]]) -> list[list[list[float]]]:
       out = []
       for seq in x:
           seq_out = []
           for token in seq:
               row = [
                   sum(token[i] * self.weight[i][o] for i in range(self.in_features))
                   + (self.bias[o] if self.bias is not None else 0.0)
                   for o in range(self.out_features)
               ]
               seq_out.append(row)
           out.append(seq_out)
       return out

   def parameters(self) -> list:
       return [self.weight, self.bias] if self.bias is not None else [self.weight]


class RMSNorm(Module):
   """Root Mean Square Layer Normalization (Pre-RMSNorm architecture)."""
   def __init__(self, d_model: int, eps: float = 1e-5):
       super().__init__()
       self.d_model = d_model
       self.eps = eps
       self.gamma = init_vector(d_model, 1.0)

   def forward(self, x: list[list[list[float]]]) -> list[list[list[float]]]:
       out = []
       for seq in x:
           seq_out = []
           for token in seq:
               rms = math.sqrt(sum(v * v for v in token) / self.d_model + self.eps)
               seq_out.append([self.gamma[d] * (token[d] / rms) for d in range(self.d_model)])
           out.append(seq_out)
       return out

   def parameters(self) -> list:
       return [self.gamma]


