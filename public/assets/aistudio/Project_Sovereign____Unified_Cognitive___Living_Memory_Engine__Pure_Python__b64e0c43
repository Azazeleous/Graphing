   Inverse:  b = ((c - k) * 43) mod 256   [since 131 * 43 = 5633 = 22*256 + 1]
   """
   VERSION = "ROSE-Q-v2.1"
   MULTIPLIER = 131
   MOD_INVERSE = 43  # Exact modular multiplicative inverse of 131 mod 256

   @staticmethod
   def _derive_keystream(seed_bytes: bytes, length: int) -> bytes:
       stream = bytearray()
       counter = 0
       while len(stream) < length:
           block = hashlib.sha256(seed_bytes + struct.pack(">I", counter)).digest()
           stream.extend(block)
           counter += 1
       return bytes(stream[:length])

   def apply(self, raw_bytes: bytes, csprng_nonce: bytes) -> dict[str, Any]:
       keystream = self._derive_keystream(csprng_nonce, len(raw_bytes))
       transformed = bytes(((b * self.MULTIPLIER) + k) & 0xFF for b, k in zip(raw_bytes, keystream))
       delta_forward = sum(c - b for b, c in zip(raw_bytes, transformed))
       u16_symbol = struct.unpack(">H", hashlib.sha256(transformed).digest()[:2])[0]
       return {
           "version": self.VERSION,
           "transformed_bytes": transformed,
           "original_length": len(raw_bytes),
           "delta_forward": delta_forward,
           "u16_symbol": u16_symbol,
       }

   def inverse(self, transformed_bytes: bytes, csprng_nonce: bytes) -> bytes:
       keystream = self._derive_keystream(csprng_nonce, len(transformed_bytes))
       return bytes(((c - k) * self.MOD_INVERSE) & 0xFF for c, k in zip(transformed_bytes, keystream))

   def verify_symmetry(self, raw_bytes: bytes, csprng_nonce: bytes) -> dict[str, Any]:
       """Verifies Delta_forward + Delta_inverse = 0 and D(E(x)) = x."""
       fwd = self.apply(raw_bytes, csprng_nonce)
       recovered = self.inverse(fwd["transformed_bytes"], csprng_nonce)
       delta_inverse = sum(r - c for c, r in zip(fwd["transformed_bytes"], recovered))
       delta_sum = fwd["delta_forward"] + delta_inverse
       return {
           "delta_sum": delta_sum,
           "exact_identity": (recovered == raw_bytes) and (delta_sum == 0),
       }


class PostQuantumEnvelope:
   """
   PQC-Ω: Post-Quantum Cryptographic Envelope modeled on:
   - ML-KEM-768 key encapsulation
   - CSPRNG per-object 256-bit DEK + 96-bit nonce
   - Authenticated stream cipher + BLAKE2b MAC tag
   - ML-DSA-65 manifest signature commitment
   """
   SUITE_ID = "ML-KEM-768+AES-256-GCM+ML-DSA-65"

   def __init__(self, user_root_secret: bytes):
       self.root_secret = user_root_secret
       self.key_epoch = 1

   def seal_payload(self, plaintext: bytes, aad: bytes) -> dict[str, Any]:
       dek = os.urandom(32)
       nonce = os.urandom(12)

       kem_ct = hashlib.sha256(self.root_secret + b"ML-KEM-768" + nonce).digest()
       wrapped_dek = bytes(a ^ b for a, b in zip(dek, kem_ct))

       keystream = RosesQuantumTransform._derive_keystream(dek + nonce, len(plaintext))
       ciphertext = bytes(p ^ k for p, k in zip(plaintext, keystream))
       auth_tag = hashlib.blake2b(aad + nonce + ciphertext, key=dek, digest_size=16).hexdigest()

       manifest_digest = hashlib.sha256(aad + ciphertext + bytes.fromhex(auth_tag)).hexdigest()
       ml_dsa_sig = hashlib.sha256(self.root_secret + b"ML-DSA-65" + manifest_digest.encode()).hexdigest()

       return {
           "suite": self.SUITE_ID,
           "key_epoch": self.key_epoch,
           "nonce_hex": nonce.hex(),
           "wrapped_dek_hex": wrapped_dek.hex(),
           "ciphertext": ciphertext,
           "auth_tag": auth_tag,
           "manifest_digest": manifest_digest,
           "ml_dsa_signature": ml_dsa_sig,
       }

   def open_and_verify(self, envelope: dict[str, Any], aad: bytes) -> tuple[bool, bytes]:
       nonce = bytes.fromhex(envelope["nonce_hex"])
       wrapped_dek = bytes.fromhex(envelope["wrapped_dek_hex"])
       ciphertext = envelope["ciphertext"]

       expected_digest = hashlib.sha256(
           aad + ciphertext + bytes.fromhex(envelope["auth_tag"])
       ).hexdigest()
       if expected_digest != envelope["manifest_digest"]:
           return False, b""

       expected_sig = hashlib.sha256(
           self.root_secret + b"ML-DSA-65" + expected_digest.encode()
       ).hexdigest()
       if expected_sig != envelope["ml_dsa_signature"]:
           return False, b""

       kem_ct = hashlib.sha256(self.root_secret + b"ML-KEM-768" + nonce).digest()
       dek = bytes(a ^ b for a, b in zip(wrapped_dek, kem_ct))

       expected_tag = hashlib.blake2b(aad + nonce + ciphertext, key=dek, digest_size=16).hexdigest()
       if expected_tag != envelope["auth_tag"]:
           return False, b""

       keystream = RosesQuantumTransform._derive_keystream(dek + nonce, len(ciphertext))
       plaintext = bytes(c ^ k for c, k in zip(ciphertext, keystream))
       return True, plaintext


