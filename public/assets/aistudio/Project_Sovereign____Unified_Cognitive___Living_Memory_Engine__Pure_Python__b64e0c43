class ImmutableMerkleLedger:
   """IMMUTABLE-Ω: Append-only SHA-256 hash-chained ledger with Merkle root checkpoints."""
   def __init__(self):
       self.entries: list[dict[str, Any]] = []
       self.head_hash = "0" * 64

   def append_event(self, event_id: str, payload_digest: str, metadata_digest: str) -> dict[str, Any]:
       commitment_material = f"{self.head_hash}|{event_id}|{payload_digest}|{metadata_digest}".encode()
       new_commitment = hashlib.sha256(commitment_material).hexdigest()
       record = {
           "index": len(self.entries),
           "event_id": event_id,
           "previous_commitment": self.head_hash,
           "payload_digest": payload_digest,
           "metadata_digest": metadata_digest,
           "commitment": new_commitment,
       }
       self.entries.append(record)
       self.head_hash = new_commitment
       return record

   def compute_merkle_root(self) -> str:
       if not self.entries:
           return self.head_hash
       layer = [e["commitment"] for e in self.entries]
       while len(layer) > 1:
           if len(layer) % 2 == 1:
               layer.append(layer[-1])
           layer = [
               hashlib.sha256((layer[i] + layer[i + 1]).encode()).hexdigest()
               for i in range(0, len(layer), 2)
           ]
       return layer[0]

   def verify_chain(self) -> bool:
       prev = "0" * 64
       for entry in self.entries:
           material = f"{prev}|{entry['event_id']}|{entry['payload_digest']}|{entry['metadata_digest']}".encode()
           recomputed = hashlib.sha256(material).hexdigest()
           if recomputed != entry["commitment"]:
               return False
           prev = recomputed
       return True


